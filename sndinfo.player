//player things
Player/Jump1		"Sounds/Player/Jump/DSJUMP1.ogg"
Player/Jump2		"Sounds/Player/Jump/DSJUMP2.ogg"
Player/Jump3		"Sounds/Player/Jump/DSJUMP3.ogg"
Player/Jump4		"Sounds/Player/Jump/DSJUMP4.ogg"
$random Player/Jump
{
	Player/Jump1
	Player/Jump2
	Player/Jump3
	Player/Jump4
}
$playeralias	player		male	*jump  Player/Jump


Player/land1	"Sounds/Player/Land/jmpland1.ogg"
Player/land2	"Sounds/Player/Land/jmpland2.ogg"
Player/land3	"Sounds/Player/Land/jmpland3.ogg"
Player/land4	"Sounds/Player/Land/jmpland4.ogg"
Player/land5	"Sounds/Player/Land/jmpland5.ogg"
$random Player/Land 
{ 
	Player/land1 
	Player/land2 
	Player/land3 
	Player/land4 
	Player/land5 
}
$playeralias player	male *land Player/Land

Player/Pain1	"Sounds/Player/BJPain1.mp3"
Player/Pain2	"Sounds/Player/BJPain2.mp3"
Player/Pain3	"Sounds/Player/BJPain3.mp3"
Player/Pain4	"Sounds/Player/BJPain4.mp3"
Player/Pain5	"Sounds/Player/BJPain5.mp3"
$RANDOM Player/Pain
{
Player/Pain1
Player/Pain2
Player/Pain3
Player/Pain4
Player/Pain5
}
$playeralias player male *pain100 Player/Pain
$playeralias player male *pain75 Player/Pain
$playeralias player male *pain50 Player/Pain
$playeralias player male *pain25 Player/Pain

